    "db:local": "wrangler d1 migrations apply DB --local",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@resvg/resvg-wasm": "2.6.2",
    "linkedom": "0.18.13",
    "saxes": "6.0.0",
    "tsx": "^4.20.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261021.1",
    "@types/node": "^22.18.0",
    "typescript": "^5.9.2",
    "wrangler": "4.151.3"
  }
}
