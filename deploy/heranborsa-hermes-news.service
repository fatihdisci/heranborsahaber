[Unit]
Description=Independent habnews private news review services
After=network-online.target docker.service
Wants=network-online.target
[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/habnews
ExecStart=/usr/bin/docker compose -f deploy/compose.yaml up -d
ExecStop=/usr/bin/docker compose -f deploy/compose.yaml stop
TimeoutStartSec=120
TimeoutStopSec=60
[Install]
WantedBy=multi-user.target
