{
  "name": "sector-haber",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "build": "wrangler deploy --dry-run --outdir dist",
    "dev": "wrangler dev --test-scheduled",
    "demo": "tsx scripts/demo.ts",
